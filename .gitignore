.DS_Store
*.bak
*.swp
.idea/
.vscode/
*.tgz
.claude/

# Terraform - .terraform.lock.hcl IS committed (pins provider versions), everything
# else here is local state/cache that shouldn't be.
cluster-setup/terraform/.terraform/
cluster-setup/terraform/*.tfstate
cluster-setup/terraform/*.tfstate.*
cluster-setup/terraform/*.tfplan
cluster-setup/terraform/crash.log
# Generated by the kind provider - contains this cluster's client cert/key.
cluster-setup/terraform/kind-ai-cluster-config

# Real values go here - env-setup/.env.example is the committed template.
env-setup/.env
