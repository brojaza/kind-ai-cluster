# Copy this file to prereqs/.env (gitignored) and edit it, then run
# ./prereqs/apply-env.sh. See that script for exactly what each of these touches -
# it writes them into the relevant git-tracked values.yaml, since Argo CD only reads
# from git and has no concept of a shell env var.

# Required.
GIT_REPO_URL=https://github.com/YOUR_USERNAME/YOUR_REPO.git

# Everything below is optional - omit any of these and apply-env.sh falls back to
# the value already committed in the corresponding chart.

# Host-based routing (see README.md's "Host-based routing" section). Requires an
# /etc/hosts entry (or real DNS on a non-local cluster) pointing each at 127.0.0.1.
ARGOCD_HOST=argocd.company.test
CHAT_HOST=chat.company.test

# vLLM GPU + scale-to-zero (see charts/vllm/values.yaml's gpu.enabled and
# autoscaling.scaleToZero for the full explanation of each). If you flip
# VLLM_SCALE_TO_ZERO_ENABLED, also see the comment on charts/open-webui/values.yaml's
# backend.baseUrl - apply-env.sh will remind you, but won't change it for you.
VLLM_GPU_ENABLED=true
VLLM_SCALE_TO_ZERO_ENABLED=true
VLLM_SCALEDOWN_PERIOD=300
